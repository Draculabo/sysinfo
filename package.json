{
  "name": "@draculabo/sysinfo-process-enhanced",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "sysinfo",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "x86_64-unknown-freebsd",
      "i686-pc-windows-msvc",
      "armv7-linux-androideabi"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.0.3",
    "ava": "^8.0.0",
    "oxlint": "^1.8.0",
    "systeminformation": "^5.27.7"
  },
  "ava": {
    "timeout": "3m",
    "files": [
      "__test__/**/*.spec.mjs"
    ]
  },
  "engines": {
    "node": ">= 14"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "lint": "oxlint",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "yarn test:unit && yarn test:integration && ava",
    "universal": "napi universal",
    "version": "napi version",
    "test:unit": "node --test test/query.test.cjs",
    "test:integration": "node scripts/test-processes.mjs",
    "check:packages": "node scripts/prepare-packages.mjs",
    "test:install": "node scripts/test-install.mjs",
    "benchmark": "node benchmarks/compare.mjs",
    "test:electron": "node scripts/test-electron.mjs"
  },
  "packageManager": "yarn@4.18.0",
  "repository": "https://github.com/Draculabo/sysinfo.git",
  "description": "Read-only async process snapshots with independent caller deadlines and coalesced native scans",
  "files": [
    "index.js",
    "index.d.ts",
    "lib/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
